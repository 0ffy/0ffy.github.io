					&lt;td&gt;1.5B&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;GPT-3&lt;/td&gt;
					&lt;td&gt;May 2020&lt;/td&gt;
